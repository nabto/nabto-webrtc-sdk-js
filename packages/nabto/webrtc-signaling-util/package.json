{
  "name": "@nabto/webrtc-signaling-util",
  "version": "0.0.1",
  "description": "Utils for Nabto WebRTC Signaling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest",
    "lint": "eslint .",
    "build": "tsup"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "format": [
      "esm",
      "cjs"
    ]
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "author": "Nabto Aps",
  "license": "",
  "dependencies": {
    "@nabto/webrtc-signaling-client": "workspace:*",
    "@nabto/webrtc-signaling-common": "workspace:*",
    "@nabto/webrtc-signaling-device": "workspace:*",
    "jsrsasign": "^11.1.5",
    "jsrsasign-util": "^1.0.5",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^2.13.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react-native-get-random-values": "*"
  },
  "peerDependenciesMeta": {
    "react-native-get-random-values": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nabto/nabto-webrtc-sdk-js"
  },
  "homepage": "https://nabto.com"
}
