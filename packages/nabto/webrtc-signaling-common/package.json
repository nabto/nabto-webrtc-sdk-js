    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "fastify": "^5.12.7",
    "globals": "^15.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
